# Copy to .env.local for local dev

# --- Database ---
# SQLite for dev (works out of the box):
DATABASE_URL="file:./prisma/dev.db"
# For production, switch to Postgres:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hospital_assets?schema=public"
# DATABASE_PROVIDER=postgresql

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_local_dev_only_do_not_ship_this"
NEXTAUTH_URL="http://localhost:3000"

# --- Seed accounts (used by prisma seed) ---
SEED_ADMIN_EMAIL="admin@hospital.local"
SEED_ADMIN_PASSWORD="ChangeMe!Admin2026"
SEED_USER_EMAIL="user@hospital.local"
SEED_USER_PASSWORD="ChangeMe!User2026"

# --- File storage ---
# "local"  -> writes under storage/local (dev)
# "s3"     -> writes to S3-compatible bucket (prod)
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage/local"
STORAGE_PUBLIC_BASE_URL="/api/files"

# S3 (only used when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Public site URL used in QR codes and Excel URL columns
PUBLIC_APP_URL="http://localhost:3000"
