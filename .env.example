# ============================================================
# Vercel deployment — set these in the Vercel project's env vars
# ============================================================

# --- Database ---
# Provision Vercel Postgres, Neon, or Supabase and paste the connection
# string. Must be Postgres (postgres:// or postgresql://). SQLite is not
# supported on Vercel because serverless filesystems are ephemeral.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hospital_assets?schema=public"
# For Vercel Postgres you can also use the pooled URL Vercel injects:
# DATABASE_URL="${POSTGRES_PRISMA_URL}"

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
# NEXTAUTH_URL is set automatically by Vercel from VERCEL_URL — leave
# blank in prod. Set it explicitly for local dev.
NEXTAUTH_URL="http://localhost:3000"

# Public URL used for QR codes and Excel round-trip URLs.
# Leave blank on Vercel — it falls back to https://$VERCEL_URL.
PUBLIC_APP_URL="http://localhost:3000"

# --- Seed accounts (used on every deploy) ---
# The seed script is idempotent — it upserts the users with these
# credentials, but does NOT reset the password once the user exists.
# Change these BEFORE first deploy and log in to change the passwords.
SEED_ADMIN_EMAIL="admin@hospital.local"
SEED_ADMIN_PASSWORD="ChangeMe!Admin2026"
SEED_USER_EMAIL="user@hospital.local"
SEED_USER_PASSWORD="ChangeMe!User2026"

# --- File storage ---
# "local"       -> writes under storage/local (dev only)
# "vercel-blob" -> Vercel Blob (auto-picked when BLOB_READ_WRITE_TOKEN is set)
# "s3"          -> (planned) S3-compatible bucket
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage/local"
STORAGE_PUBLIC_BASE_URL="/api/files"

# --- Email (used only for password-reset emails) ---
# "console"  -> print the message to the server log (dev / no-SMTP; the
#               admin reset flow still works — it always returns the
#               link so admins can hand it over via WhatsApp/SMS)
# "resend"   -> POST to Resend's HTTP API (free tier: 100 emails/day).
#               Get a key at https://resend.com/api-keys
EMAIL_DRIVER="console"
EMAIL_FROM="RBH Assets <onboarding@resend.dev>"
RESEND_API_KEY=""

# --- Sentry (optional error monitoring) ---
# Get a DSN from https://sentry.io. When unset, all Sentry code is a no-op.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENV="production"
NEXT_PUBLIC_SENTRY_ENV="production"
SENTRY_TRACES="0.05"
NEXT_PUBLIC_SENTRY_TRACES="0.05"
# For source-map uploads at build time — optional; leave blank to skip.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Audit log retention ---
# Rows in AuditLog older than this many days are deleted by the
# nightly cron declared in vercel.json (/api/cron/audit-retention).
# Hospital defaults: 2 years (~ 730 days). Raise for compliance rules
# that require longer retention.
AUDIT_RETENTION_DAYS="730"
# Shared secret used to POST to the cron endpoint from outside Vercel
# (e.g. from your laptop to force an immediate prune). Vercel-triggered
# cron doesn't need this — Vercel signs its own requests with
# x-vercel-cron.
CRON_SECRET=""

# Vercel Blob: enable Blob for the project in the Vercel dashboard;
# Vercel then injects BLOB_READ_WRITE_TOKEN automatically. No manual
# action needed here.

# S3 (only used when STORAGE_DRIVER=s3 — driver stub, not shipped)
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
